# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy backend source
COPY backend/ ./backend/

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -o sarosobserv ./backend/cmd/sarosobserv/

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

COPY --from=builder /app/sarosobserv .

EXPOSE 4317 4318 8080

CMD ["./sarosobserv"]
